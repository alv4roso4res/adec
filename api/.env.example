# Copie para .env (que está no .gitignore) e preencha. Nunca commite o .env.

# Token do GitHub. Precisa ser classic com os escopos public_repo + read:packages
# (o fine-grained não lê pacotes do GHCR). Vazio = chamadas anônimas, com rate limit baixo.
GITHUB_TOKEN=

# Repositório que o painel monitora (https://github.com/<owner>/<repo>)
GITHUB_OWNER=
GITHUB_REPO=

# Arquivo do workflow de CI em .github/workflows/ (padrão ci.yml)
GITHUB_WORKFLOW_FILE=ci.yml

# Logins do GitHub dos integrantes do time, separados por vírgula (ex.: ana,bia,caio)
TEAM_LOGINS=

# Imagens publicadas no GHCR, separadas por vírgula (ou JSON). Padrão: adec-api,adec-frontend
GHCR_IMAGES=adec-api,adec-frontend

# Dono das imagens no GHCR. Vazio = usa GITHUB_OWNER (convertido para minúsculas)
GHCR_OWNER=

# Habilita ações que escrevem no GitHub (ex.: merge). Mantenha false por padrão.
ENABLE_WRITE_ACTIONS=false

# Método de merge dos PRs quando as ações de escrita estão ligadas: merge ou squash
MERGE_METHOD=merge

# Quantos PRs abertos o painel lista (mínimo 1)
PULLS_LIMIT=5

# Quantos runs/deploys aparecem no histórico (mínimo 1)
HISTORY_LIMIT=20

# Versão exposta em /api/health. Padrão "dev".
# No Docker ela vem do build-arg APP_VERSION embutido na imagem, então deixe
# comentada: definir aqui sobrescreveria a versão da imagem em tempo de execução.
# APP_VERSION=dev
