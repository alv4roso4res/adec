# Copie para .env (que está no .gitignore) e preencha. Nunca commite o .env.

# Token do GitHub (fine-grained ou classic). Vazio = chamadas anônimas, com rate limit baixo.
GITHUB_TOKEN=

# Repositório que o painel monitora (https://github.com/<owner>/<repo>)
GITHUB_OWNER=
GITHUB_REPO=

# Logins do GitHub dos integrantes do time, separados por vírgula (ex.: ana,bia,caio)
TEAM_LOGINS=

# Nome do pacote no GHCR (ex.: adec-api)
GHCR_PACKAGE=

# Habilita ações que escrevem no GitHub (ex.: merge). Mantenha false por padrão.
ENABLE_WRITE_ACTIONS=false

# Segundos de cache das respostas do GitHub
CACHE_TTL_SECONDS=15

# Versão exposta em /api/health. Padrão "dev".
# No Docker ela vem do build-arg APP_VERSION embutido na imagem, então deixe
# comentada: definir aqui sobrescreveria a versão da imagem em tempo de execução.
# APP_VERSION=dev
