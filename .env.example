# Lido pelo docker compose (interpolação em docker-compose.yml). Copie para .env.

# Dono das imagens no GHCR. Precisa ser minúsculo.
GHCR_OWNER=alv4roso4res

# Tag das imagens (CI publica a tag do commit; "latest" para o deploy contínuo)
IMAGE_TAG=latest

# Versão embutida nas imagens (health da API, version.json do frontend)
APP_VERSION=dev
